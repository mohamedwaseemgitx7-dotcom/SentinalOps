{
  "name": "@sentinelops/desktop",
  "productName": "SentinelOps",
  "version": "0.2.0",
  "private": true,
  "description": "SentinelOps — local-first DevOps monitoring and security dashboard",
  "author": {
    "name": "Mohamed Waseem"
  },
  "license": "MIT",
  "homepage": "https://github.com/mohamedwaseemgitx7-dotcom/dmonitz",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "dist:store": "npm run build && electron-builder --win appx --x64 --publish never --config electron-builder.store.cjs"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "dev.sentinelops.desktop",
    "productName": "SentinelOps",
    "copyright": "Copyright © 2026 Mohamed Waseem",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "SentinelOps"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SentinelOps",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
