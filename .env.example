# Copy to .env (never commit .env). All values are optional.

# Read-only GitHub token for private repositories and higher API limits.
# Prefer a fine-grained token with: Metadata (read), Contents (read), Actions (read).
# Alternatively leave empty and enable "Use my local GitHub CLI login" in Settings.
GITHUB_TOKEN=

# Server
SENTINELOPS_HOST=127.0.0.1
SENTINELOPS_PORT=4600
# SENTINELOPS_DATA_DIR=./data

# Set to true when served over HTTPS (adds Secure cookies + HSTS).
SENTINELOPS_SECURE_COOKIES=false
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For.
SENTINELOPS_TRUST_PROXY=false

SENTINELOPS_SESSION_TTL_HOURS=12
SENTINELOPS_AUTH_RATE_LIMIT=10
SENTINELOPS_API_RATE_LIMIT=600
LOG_LEVEL=info
